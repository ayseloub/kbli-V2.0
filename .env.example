# --- Database & cache ---
DATABASE_URL=postgresql://kbli:kbli@localhost:55432/kbli
REDIS_URL=redis://localhost:6379/0

# --- Retrieval ---
# Ganti dengan varian IndoSBERT yang dipakai di skripsi.
EMBED_MODEL=denaya/indoSBERT-large
# Harus sama dengan VECTOR(n) di db/schema.sql
EMBED_DIM=256
KBLI_INDEX_DIR=data/processed
# Dipilih lewat: python -m eval.ablation --model <EMBED_MODEL>
DENSE_STRATEGY=max
FUSION=linear
FUSION_W_BM25=0.6
# Disetel lewat: python -m eval.calibrate --model <EMBED_MODEL>
CONFIDENT_MIN_SCORE=0.675
CONFIDENT_MIN_FUSED_MARGIN=0.1
OUT_OF_SCOPE_MAX_SCORE=0.51
INTENT_RERANK=true
INTENT_PENALTY=0.7

# --- LLM (format OpenAI-compatible: Groq, OpenRouter, Gemini, Ollama, vLLM) ---
LLM_ENABLED=true
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Cek model yang tersedia untuk akunmu: GET https://api.groq.com/openai/v1/models
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=600
LLM_REASONING_EFFORT=low       # kosongkan untuk model non-reasoning (mis. llama-3.1-8b-instant)
LLM_TIMEOUT_S=20

# --- Knowledge base dokumen ---
DOCS_ENABLED=true
# bge-m3: ±2,3 GB unduhan pertama kali, ±2,5 GB RAM. Dimuat saat pertama dibutuhkan.
DOC_EMBED_MODEL=BAAI/bge-m3
DOC_EMBED_DIM=1024
DOC_TOP_K=4
# Disetel lewat: python -m eval.doc_calibrate (setelah ada dokumen aktif)
DOC_MIN_SCORE=0.45
DOC_WORKER_ENABLED=true
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=25

# --- Auth ---
# Wajib diganti! Buat yang acak: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_TTL_HOURS=168
COOKIE_SECURE=false            # true kalau sudah pakai HTTPS
ALLOW_REGISTRATION=false      # publik chat tanpa akun; admin dibuat: python -m api.create_admin
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1          # Nginx saja = 1; ada Cloudflare/load balancer di depan Nginx = 2

# --- Limit ---
RATE_LIMIT_PER_MINUTE=20
LLM_QUOTA_ANON_PER_DAY=10
LLM_QUOTA_USER_PER_DAY=20
LLM_GLOBAL_PER_DAY=800
MAX_INPUT_CHARS=1000
CHAT_TOP_K=5
MAX_CONCURRENT_INFERENCE=4
