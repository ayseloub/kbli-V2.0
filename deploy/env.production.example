# Salin ke .env di folder project pada VPS:  cp deploy/env.production.example .env
# Lalu isi semua yang bertanda <...>.

# --- Server & domain ---
DOMAIN=<chat.domainmu.id>              # domain/subdomain yang A record-nya mengarah ke IP VPS
HOME_URL=/                             # tujuan tombol ← di header chat (mis. https://website-utama.go.id)
ROOT_REDIRECT=/chat                    # buka https://DOMAIN/ diarahkan ke sini
POSTGRES_PASSWORD=<buat: openssl rand -hex 24>

# --- Keamanan ---
JWT_SECRET=<buat: openssl rand -base64 48>
ALLOW_REGISTRATION=false

# --- Retrieval KBLI ---
EMBED_MODEL=denaya/indoSBERT-large
EMBED_DIM=256
DENSE_STRATEGY=max
FUSION=linear
FUSION_W_BM25=0.6
CONFIDENT_MIN_SCORE=0.675
CONFIDENT_MIN_FUSED_MARGIN=0.05
OUT_OF_SCOPE_MAX_SCORE=0.51
INTENT_RERANK=true
INTENT_PENALTY=0.7
CHAT_TOP_K=5

# --- Disk kecil (20 GB) ---
KBLI_KEEP_VERSIONS=10                  # riwayat versi data KBLI (±9 MB per versi)

# --- Dokumen ---
# false = bge-m3 (±2,3 GB disk, ±2,5 GB RAM) tidak diunduh. Nyalakan kalau sudah mau upload dokumen.
DOCS_ENABLED=true
DOC_EMBED_MODEL=BAAI/bge-m3
DOC_EMBED_DIM=1024
DOC_MIN_SCORE=0.45                     # setel ulang: docker compose ... exec api python -m eval.doc_calibrate
MAX_UPLOAD_MB=25

# --- LLM (Groq) ---
LLM_ENABLED=true
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=<gsk_...>
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=600
LLM_REASONING_EFFORT=low

# --- Limit ---
RATE_LIMIT_PER_MINUTE=20
LLM_QUOTA_ANON_PER_DAY=10
LLM_QUOTA_USER_PER_DAY=20
LLM_GLOBAL_PER_DAY=800
